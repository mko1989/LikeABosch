# Copy to .env (gitignored). The Electron launcher (WO-030) passes these as env vars instead.

# Web server
PORT=3000
# 127.0.0.1 = this machine only. The UI has no login yet (DEC-005), so only use 0.0.0.0 on a trusted LAN.
BIND_HOST=127.0.0.1
LOG_LEVEL=info
# Data folder (projects, settings). Default: the per-user folder shared with the launcher
# (macOS ~/Library/Application Support/LikeABosch, Windows %APPDATA%\LikeABosch). DEC-016.
# DATA_DIR=

# DICENTIS connection
DICENTIS_SYSTEM=wired            # wired | wireless | dcn-smd (DCN meeting data stream, read-only, DEC-018) | dcn (DCN via dcn-bridge, DEC-017)
DICENTIS_HOST=172.16.4.1
DICENTIS_PORT=                   # default: 31416 (wired), 80 (wireless), 9480 (dcn: the dcn-bridge), 20000 (dcn-smd: the DCN-SW server PC)
DICENTIS_USER=                   # not needed for dcn-smd (the DCN-SW server allows clients by IP)
DICENTIS_PASSWORD=
DICENTIS_TLS_INSECURE=true       # wired server uses a self-signed certificate by default
DICENTIS_AUTOCONNECT=true
# dcn only: HOST/PORT = the dcn-bridge, USER/PASSWORD = the DCN-SW user
DICENTIS_DCN_SERVER=             # default: tcp://localhost:9461 (DCN-SW server as seen from the bridge)
DICENTIS_BRIDGE_TOKEN=           # shared secret, same as dcn-bridge --token
# Simulation (WO-098, DEC-026): simulate a system with no hardware, e.g. wired:40 (type wired|wireless|dcn|dcn-smd : seats)
LIKEABOSCH_SIMULATE=
